rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDocPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function isAdmin() {
      return signedIn()
        && exists(userDocPath(request.auth.uid))
        && get(userDocPath(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function canCreateGuestOrder() {
      return request.auth == null
        && request.resource.data.userId == 'anonymous'
        && request.resource.data.items is list
        && request.resource.data.totalAmount is number;
    }

    function canCreateUserOrder() {
      return signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.items is list
        && request.resource.data.totalAmount is number;
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if isAdmin() || canCreateGuestOrder() || canCreateUserOrder();
      allow read: if isAdmin()
        || (signedIn()
          && resource.data.userId != 'anonymous'
          && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow create: if isOwner(userId)
        && request.resource.data.role == 'user'
        && request.resource.data.email is string;

      allow read: if isAdmin() || isOwner(userId);

      allow update: if isAdmin()
        || (isOwner(userId)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'role',
            'email',
            'createdAt'
          ]));

      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
